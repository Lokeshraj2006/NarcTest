# FieldProof — Environment Configuration
# Copy this file to .env and fill in values. Never commit .env.

# ── Database ───────────────────────────────
# Quick demo (no install needed):
DATABASE_URL=sqlite:///./fieldproof.db
# PostgreSQL (later):
# DATABASE_URL=postgresql://<db_user>:<db_password>@localhost:5432/fieldproof_db

# ── JWT Authentication ─────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── NTP (trusted time) ─────────────────────
NTP_SERVER=pool.ntp.org
NTP_MAX_DRIFT_SECONDS=5

# ── Application ────────────────────────────
APP_NAME=FieldProof
APP_VERSION=0.1.0
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── FieldProof ─────────────────────────────
# Base URL used in QR codes / verify links. Leave empty to use the URL the
# phone or browser called (e.g. http://192.168.1.20:8000).
# PUBLIC_BASE_URL=http://<your-lan-ip>:8000
# Demo users' password. seed_demo adds a random one here if missing.
# DEMO_PASSWORD=<set by seed_demo>
# Optional folder overrides (defaults: backend/keys and backend/uploads)
# KEYS_DIR=./keys
# UPLOADS_DIR=./uploads
