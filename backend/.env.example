# FieldProof — Environment Configuration
# ──────────────────────────────────────────
# Copy this file to .env and fill in values.

# ── Database ───────────────────────────────
DATABASE_URL=postgresql://fieldproof:fieldproof_dev@localhost:5432/fieldproof_db

# ── JWT Authentication ─────────────────────
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_HEX_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Evidence Storage ───────────────────────
# "local" for dev, "gcs" for production
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./uploads
# GCS_BUCKET_NAME=fieldproof-evidence  # Uncomment for GCP

# ── NTP Configuration ─────────────────────
NTP_SERVER=pool.ntp.org
NTP_MAX_DRIFT_SECONDS=5

# ── Application ────────────────────────────
APP_NAME=FieldProof
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
